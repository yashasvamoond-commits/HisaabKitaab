{
  "name": "hisaabkitaab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-ocr.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
