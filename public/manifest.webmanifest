{
  "id": "./",
  "name": "HisaabKitaab — apna hisaab, apni zubaani",
  "short_name": "Hisaab",
  "description": "Doston, family aur dukaandaar ke saath hisaab. Screenshot ya chat bhejo, khata apne aap ban jaata hai.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "./?src=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FFF8EE",
  "theme_color": "#FFF8EE",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Screenshot se hisaab",
      "short_name": "Screenshot",
      "url": "./#/scan?mode=image",
      "description": "Payment screenshot padho aur hisaab mein daalo"
    },
    {
      "name": "Chat se hisaab",
      "short_name": "Chat",
      "url": "./#/scan?mode=text",
      "description": "WhatsApp ya SMS ka message paste karo"
    },
    {
      "name": "Sabka hisaab",
      "short_name": "Log",
      "url": "./#/people"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "screenshot",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/heic", "image/*"]
        }
      ]
    }
  },
  "prefer_related_applications": false
}
