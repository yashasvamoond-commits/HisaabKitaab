{
  "id": "./",
  "name": "HisaabKitaab — Shared expenses",
  "short_name": "HisaabKitaab",
  "description": "Track shared expenses, add payment screenshots and keep every balance up to date.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "./?src=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F4F5F7",
  "theme_color": "#F4F5F7",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add from screenshot",
      "short_name": "Screenshot",
      "url": "./#/scan?mode=image",
      "description": "Read a payment screenshot and save the expense"
    },
    {
      "name": "Add from message",
      "short_name": "Message",
      "url": "./#/scan?mode=text",
      "description": "Paste a UPI SMS or chat message"
    },
    {
      "name": "People",
      "short_name": "People",
      "url": "./#/people"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "screenshot",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/heic", "image/*"]
        }
      ]
    }
  },
  "prefer_related_applications": false
}
